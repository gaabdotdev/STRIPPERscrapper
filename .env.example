# Credenciais Infnet (e-mail + senha da plataforma)
FACULDADE_USER=
FACULDADE_PASS=

# URL da página de reuniões/transcrições (default pode ser sobrescrito)
CLASSES_URL=https://infnet.online/grupos/fundamentos-do-processamento-de-dados-26e1-26e2-93422564/infnet-ci-zoom-mettings/

# Nome da disciplina nos logs e no front-matter (opcional; senão tenta ler da página / URL)
# DISCIPLINE_NAME=Fundamentos de Python para processamento de dados

# Opcional: Chrome/Chromium já instalado (necessário se npm install foi com PUPPETEER_SKIP_DOWNLOAD=true)
# Windows exemplo: PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# HEADLESS=0 mostra o browser; ou na CLI: node stripper.js --headed (ou --show)
# PUPPETEER_EXECUTABLE_PATH=

# Portão de captcha manual (local): browser visível → espera → fecha → scrape headless
# CAPTCHA_GATE=1   (predefinição; use 0 ou --no-captcha-gate para desativar)
# CAPTCHA_WAIT_MS=60000   (tempo máximo para resolver login/captcha, em ms)

# --- documentsScraper.js (BuddyPress Documentos) ---
# DOCUMENTS_URL=https://infnet.online/grupos/SEU-SLUG/documents/
# Se omitires DOCUMENTS_URL mas tiveres CLASSES_URL no mesmo formato …/grupos/{slug}/…, o scraper infere …/grupos/{slug}/documents/ automaticamente.
# DOCUMENTS_OUTPUT_DIR=./downloads/documents
# DOCUMENTS_MAX_DEPTH=32
# Se definido, **substitui** o conjunto de extensões aceites (sem ponto), separadas por vírgula — ex.: só vídeo: mp4,mov
# DOCUMENTS_EXTENSIONS=mp4,mov
# Limite por ficheiro (default no código: 20 GiB). Ex.: 50 GiB → 53687091200
# DOCUMENTS_MAX_BYTES=21474836480
# Tolerância de integridade quando Content-Length vem subestimado (default: 10x)
# INTEGRITY_SIZE_MAX_RATIO=10
# Timeout de download por ficheiro (default: 2 h, em ms)
# DOCUMENTS_FETCH_TIMEOUT_MS=7200000
# Após documentos, extrair .zip automaticamente (default: 1). Desactivar: 0
# EXTRACT_ZIPS=1
# Ignorar manifest.json (forçar re-download de documentos já registados): 1 ou true
# DOCUMENTS_IGNORE_MANIFEST=
